# Conexión a Postgres (en Easypanel: "Internal connection URL" del servicio de Postgres)
DATABASE_URL=postgres://an:an@localhost:5432/an

# Cuenta de administrador que se crea la primera vez que arranca el servidor.
# Después, la contraseña se cambia desde Ajustes → Cuenta y las demás cuentas
# se crean desde Ajustes → Usuarios.
ADMIN_EMAIL=admin
AN_PASSWORD=

# Recuperación: si te quedas sin acceso, pon RESET_ADMIN_PASSWORD=true, reinicia
# y la contraseña del administrador pasará a ser AN_PASSWORD. Quítala después.
# RESET_ADMIN_PASSWORD=true

# Zona horaria de los mensajes de WhatsApp
TIMEZONE=Europe/Madrid

# Solo en local (http://localhost): las cookies no exigen HTTPS
SECURE_COOKIES=false

# WhatsApp se configura desde Ajustes → WhatsApp (cada usuario el suyo)
