# Puerto del servidor de recordatorios
PORT=3001
# Zona horaria para el texto de los mensajes
TIMEZONE=Europe/Madrid

# Proveedor de WhatsApp: "callmebot" (gratis, uso personal) o "twilio"
WHATSAPP_PROVIDER=callmebot

# Tu número personal en formato internacional, sin espacios (ej: +34600111222)
WHATSAPP_PHONE=

# --- CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/) ---
CALLMEBOT_APIKEY=

# --- Twilio (https://www.twilio.com/whatsapp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número remitente de WhatsApp de Twilio (sandbox: +14155238886)
TWILIO_WHATSAPP_FROM=+14155238886
